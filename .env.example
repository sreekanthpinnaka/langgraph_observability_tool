# 🔭 LangGraph Observability Environment Configuration Example

# Option 1: Google Cloud SQL (MySQL) / MySQL Database
# DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<HOST_OR_PUBLIC_IP>:3306/<DB_NAME>

# Option 2: Local SQLite (default fallback if DATABASE_URL is not set)
# DATABASE_URL=sqlite:///observe.db

# Observability Server address (used by client backends)
OBSERVE_SERVER_URL=http://localhost:8765

# Optional: API Key authentication for ingestion and dashboard
# OBSERVE_API_KEY=your-secure-secret-key-123

# Optional: Allowed CORS Origins
# OBSERVE_CORS_ORIGINS=*

# Optional: Max Request Body Size in bytes (default: 10MB)
# OBSERVE_MAX_BODY_SIZE=10485760
